{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -c \"import ast; ast.parse(open('server_monitor.py', encoding='utf-8').read())\")",
      "Bash(make help)",
      "Bash(make check-git)",
      "Bash(make info)"
    ],
    "ask": [
      "Bash(python server_monitor.py:*)",
      "Bash(python3 server_monitor.py:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(git push:*)",
      "Bash(make set-git-local:*)",
      "Bash(make install-hooks:*)",
      "Bash(make setup:*)",
      "Bash(make clean:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./config/config.yaml)"
    ]
  }
}
